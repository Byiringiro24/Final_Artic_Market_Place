# Copy to backend/.env.production.local on the VPS and fill in real values.
NODE_ENV=production
PORT=5000
API_VERSION=v1
APP_NAME=ARTIC Group Ltd | ARTIC HUB
APP_URL=https://artichub.ddnsgeek.com
FRONTEND_URL=https://artichub.ddnsgeek.com
JWT_ACCESS_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFY_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
JWT_EMAIL_VERIFY_EXPIRES_IN=24h
JWT_RESET_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
JWT_RESET_EXPIRES_IN=1h
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM_NAME=ARTIC Group Ltd | ARTIC HUB
SMTP_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER
STRIPE_SECRET_KEY=REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SECRET
PAYPAL_API_URL=https://api-m.paypal.com
PAYPAL_CLIENT_ID=REPLACE_WITH_PAYPAL_CLIENT_ID
PAYPAL_APP_SECRET=REPLACE_WITH_PAYPAL_APP_SECRET
BCRYPT_SALT_ROUNDS=12
MAX_FILE_SIZE_MB=50
