# ─── API ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── App Info ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ARTIC Marketplace
NEXT_PUBLIC_APP_DESCRIPTION=The Premier Online Marketplace

# ─── NextAuth (for session management in frontend) ────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_64_char_random_string
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# ─── Stripe (public key only in frontend) ────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
