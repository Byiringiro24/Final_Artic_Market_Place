# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Uses the existing PostgreSQL instance with user artic_user / Artic$2026
DATABASE_URL="postgresql://artic_user:Artic$2026@localhost:5432/Market_Place?schema=public&sslmode=disable"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_64_char_random_string_here_abc123
JWT_REFRESH_SECRET=replace_with_different_64_char_random_string_xyz789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFY_SECRET=replace_with_email_verify_secret_string_abc456
JWT_EMAIL_VERIFY_EXPIRES_IN=24h
JWT_RESET_SECRET=replace_with_password_reset_secret_string_def789
JWT_RESET_EXPIRES_IN=1h

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── SMTP Email ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM_NAME=ARTIC Marketplace
SMTP_FROM_EMAIL=noreply@articmarketplace.com

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── PayPal ───────────────────────────────────────────────────────────────────
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_APP_SECRET=your_paypal_app_secret

# ─── File Upload ──────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=ARTIC Marketplace
APP_URL=http://localhost:5000
BCRYPT_SALT_ROUNDS=12
