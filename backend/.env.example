# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URL=http://localhost:3000

# ─── Database (PostgreSQL via Prisma) ────────────────────────────────────────
DATABASE_URL="postgresql://artic_user:artic_secure_pass@localhost:5432/artic_marketplace?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_64_char_random_string
JWT_REFRESH_SECRET=replace_with_64_char_random_string_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFY_SECRET=replace_with_64_char_random_string_3
JWT_EMAIL_VERIFY_EXPIRES_IN=24h
JWT_RESET_SECRET=replace_with_64_char_random_string_4
JWT_RESET_EXPIRES_IN=1h

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── SMTP Email ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=ARTIC Marketplace
SMTP_FROM_EMAIL=noreply@articmarketplace.com

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── PayPal ──────────────────────────────────────────────────────────────────
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_APP_SECRET=your_paypal_app_secret

# ─── File Upload ─────────────────────────────────────────────────────────────
UPLOADTHING_TOKEN=your_uploadthing_token
MAX_FILE_SIZE_MB=10

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=ARTIC Marketplace
APP_URL=http://localhost:5000
BCRYPT_SALT_ROUNDS=12
