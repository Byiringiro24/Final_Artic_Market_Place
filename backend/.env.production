NODE_ENV=production
PORT=5000
API_VERSION=v1
APP_URL=https://artichub.ddnsgeek.com
FRONTEND_URL=https://artichub.ddnsgeek.com
DATABASE_URL=postgresql://artic_hub:replace_on_server@postgres:5432/artic_hub?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace_with_random_secret
JWT_REFRESH_SECRET=replace_with_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_EMAIL_VERIFY_SECRET=replace_with_random_secret
JWT_EMAIL_VERIFY_EXPIRES_IN=24h
JWT_RESET_SECRET=replace_with_random_secret
JWT_RESET_EXPIRES_IN=1h
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_user
SMTP_PASSWORD=replace_with_smtp_app_password
SMTP_FROM_NAME=ARTIC Group Ltd | ARTIC HUB
SMTP_FROM_EMAIL=replace_with_sender_email
STRIPE_SECRET_KEY=sk_test_replace_with_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_webhook_secret
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_APP_SECRET=replace_with_paypal_secret
APP_NAME=ARTIC Group Ltd | ARTIC HUB
BCRYPT_SALT_ROUNDS=12
MAX_FILE_SIZE_MB=50
